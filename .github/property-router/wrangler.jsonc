{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "hannah-keown-property-router",
  "main": "src/worker.mjs",
  "compatibility_date": "2026-11-22",
  "workers_dev": false,
  "routes": [
    { "pattern": "hannahkeownhomes.com/properties/*", "zone_name": "hannahkeownhomes.com" },
    { "pattern": "www.hannahkeownhomes.com/properties/*", "zone_name": "hannahkeownhomes.com" }
  ],
  "rules": [
    { "type": "Text", "globs": ["**/*.html"], "fallthrough": true }
  ]
}
